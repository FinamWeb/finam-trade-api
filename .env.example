# Общие настройки для всех примеров в этом репозитории.
#
# Скопируйте файл в .env в корне репозитория, замените значения-заглушки и
# запускайте примеры через `just`. Каждый рецепт автоматически загружает
# корневой .env:
#
#   cp .env.example .env
#   just env-status
#   just run-strategy-python sma_crossover --check
#
# .env исключён из git; никогда не коммитьте настоящий секрет. Переменные,
# уже экспортированные в оболочке, имеют приоритет над этим файлом.

# Секрет Trade API, выпущенный на https://tradeapi.finam.ru/docs/tokens/.
# Нужен каждому примеру.
TRADE_API_SECRET=tapi_sk_replace_me

# Инструмент в формате ticker@mic, например SBER@MISX (Московская биржа).
TRADE_API_SYMBOL=SBER@MISX

# Настройки стратегий. Поддерживаемые таймфреймы: M1, M5, M15, M30, H1, H2,
# H4, H8, D, W, MN и QR.
TRADE_API_TIMEFRAME=M5
TRADE_API_QUANTITY=1
TRADE_API_LOG_LEVEL=INFO

# Только для примеров с лимитной заявкой; намеренно не заданы. Эти примеры
# отправляют настоящую заявку и отказываются запускаться, пока вы не укажете
# цену и явно не подтвердите исполнение.
# TRADE_API_LIMIT_PRICE=
# TRADE_API_EXECUTE=1
