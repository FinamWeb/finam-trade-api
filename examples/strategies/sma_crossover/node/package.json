{
  "name": "@finam/example-sma-crossover",
  "version": "0.0.0",
  "private": true,
  "description": "SMA 9/30 crossover example using the published Finam Node SDK",
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "start": "tsx main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@finam/trade-api": "2.19.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
